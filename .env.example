# Optional: raises the GitHub REST API rate limit from 60/hr to 5000/hr.
# Create a fine-grained personal access token with no scopes (public data only)
# at https://github.com/settings/tokens. Not required for local dev or an
# initial deploy — the recent-activity feed works unauthenticated.
GITHUB_TOKEN=

# Where contact-form submissions are sent.
CONTACT_RECEIVER_EMAIL=otellandanusa@gmail.com

# TODO: real email sending is not wired up yet. Provisioning Resend via the
# Vercel Marketplace requires a domain you own (for DNS verification) and a
# paid plan ($20/mo Pro minimum, no free tier through the Marketplace).
# Once you're ready: `vercel integration add resend/resend-email -m domain=<yourdomain> -m region=us-east-1`,
# then set the resulting API key env var here and wire it into
# src/app/actions/send-contact-email.ts. Until then, submissions are logged
# server-side and the form shows a friendly "email me directly" message.
